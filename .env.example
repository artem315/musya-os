# Copy to .env and fill in. Never commit the real .env.
MUR_DOMAIN=murcloud.example.com
# 48+ random characters: python -c "import secrets;print(secrets.token_urlsafe(48))"
MUR_SECRET_KEY=
POSTGRES_PASSWORD=
# Optional: operator-paid AI key used when a user has not added their own (MUR Settings → AI)
MUR_AI_PROVIDER=anthropic
MUR_AI_KEY=
MUR_AI_MODEL=
# Set to 0 after creating the first (admin) account to close sign-ups
MUR_REGISTRATION_OPEN=1
# Optional S3-compatible MUR Drive storage
MUR_STORAGE=local
MUR_S3_BUCKET=
MUR_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
